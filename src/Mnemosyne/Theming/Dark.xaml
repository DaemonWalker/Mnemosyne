<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Window.Background">#FF1E1E1E</Color>
    <Color x:Key="Color.Window.Foreground">#FFD4D4D4</Color>
    <Color x:Key="Color.Control.Background">#FF252526</Color>
    <Color x:Key="Color.Control.Border">#FF3F3F46</Color>
    <Color x:Key="Color.Accent">#FF007ACC</Color>
    <Color x:Key="Color.Secondary.Foreground">#FF808080</Color>
    <Color x:Key="Color.ActivityBar.Background">#FF333333</Color>
    <Color x:Key="Color.ActivityBar.Foreground">#FF858585</Color>
    <Color x:Key="Color.ActivityBar.ActiveForeground">#FFFFFFFF</Color>
    <Color x:Key="Color.Hover.Background">#FF3E3E42</Color>
    <Color x:Key="Color.Sidebar.Background">#FF252526</Color>
    <Color x:Key="Color.TabBar.Background">#FF252526</Color>
    <Color x:Key="Color.StatusBar.Foreground">#FFFFFFFF</Color>

    <Color x:Key="Color.Editor.Background">#FF1E1E1E</Color>
    <Color x:Key="Color.Editor.Foreground">#FFD4D4D4</Color>
    <Color x:Key="Color.Editor.LineNumber">#FF858585</Color>
    <Color x:Key="Color.Editor.CaretLine">#FF2A2A2A</Color>
    <Color x:Key="Color.Editor.Selection">#FF264F78</Color>
    <Color x:Key="Color.Editor.IndentGuide">#FF404040</Color>
    <Color x:Key="Color.Editor.Caret">#FFAEAFAD</Color>
    <Color x:Key="Color.Editor.Whitespace">#FF3E3E42</Color>
    <Color x:Key="Color.Editor.Keyword">#FF569CD6</Color>
    <Color x:Key="Color.Editor.Comment">#FF6A9955</Color>
    <Color x:Key="Color.Editor.String">#FFCE9178</Color>
    <Color x:Key="Color.Editor.Number">#FFB5CEA8</Color>
    <Color x:Key="Color.Editor.Preprocessor">#FFC586C0</Color>
    <Color x:Key="Color.Editor.Type">#FF4EC9B0</Color>
    <Color x:Key="Color.Editor.Function">#FFDCDCAA</Color>
    <Color x:Key="Color.Editor.Tag">#FF569CD6</Color>
    <Color x:Key="Color.Editor.Attribute">#FF9CDCFE</Color>
    <Color x:Key="Color.Editor.Error">#FFF44747</Color>

    <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Window.Background}" />
    <SolidColorBrush x:Key="Brush.Window.Foreground" Color="{StaticResource Color.Window.Foreground}" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="{StaticResource Color.Control.Background}" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="{StaticResource Color.Control.Border}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Secondary.Foreground" Color="{StaticResource Color.Secondary.Foreground}" />
    <SolidColorBrush x:Key="Brush.ActivityBar.Background" Color="{StaticResource Color.ActivityBar.Background}" />
    <SolidColorBrush x:Key="Brush.ActivityBar.Foreground" Color="{StaticResource Color.ActivityBar.Foreground}" />
    <SolidColorBrush x:Key="Brush.ActivityBar.ActiveForeground" Color="{StaticResource Color.ActivityBar.ActiveForeground}" />
    <SolidColorBrush x:Key="Brush.Hover.Background" Color="{StaticResource Color.Hover.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="{StaticResource Color.Sidebar.Background}" />
    <SolidColorBrush x:Key="Brush.TabBar.Background" Color="{StaticResource Color.TabBar.Background}" />
    <SolidColorBrush x:Key="Brush.StatusBar.Background" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.StatusBar.Foreground" Color="{StaticResource Color.StatusBar.Foreground}" />

</ResourceDictionary>
