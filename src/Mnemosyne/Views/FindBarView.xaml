<UserControl x:Class="Mnemosyne.Views.FindBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="FindBar_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Border Background="{DynamicResource Brush.Control.Background}"
            BorderBrush="{DynamicResource Brush.Control.Border}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="6,4">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0"
                              Style="{StaticResource FindBarToggleStyle}"
                              ToolTip="{DynamicResource Loc.Find.ToggleReplace}"
                              IsChecked="{Binding IsReplaceVisible, Mode=TwoWay}">
                    <TextBlock Text="&#x276F;"
                               FontSize="10"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReplaceVisible}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Width="200"
                         FontSize="12"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="FindSearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ToggleButton Grid.Column="2"
                              Style="{StaticResource FindBarToggleStyle}"
                              ToolTip="{DynamicResource Loc.Find.MatchCase}"
                              AutomationProperties.AutomationId="FindMatchCaseToggle"
                              IsChecked="{Binding MatchCase, Mode=TwoWay}"
                              Content="Aa" />
                <ToggleButton Grid.Column="3"
                              Style="{StaticResource FindBarToggleStyle}"
                              ToolTip="{DynamicResource Loc.Find.WholeWord}"
                              AutomationProperties.AutomationId="FindWholeWordToggle"
                              IsChecked="{Binding WholeWord, Mode=TwoWay}">
                    <TextBlock Text="ab"
                               FontSize="11"
                               TextDecorations="Underline" />
                </ToggleButton>
                <ToggleButton Grid.Column="4"
                              Style="{StaticResource FindBarToggleStyle}"
                              ToolTip="{DynamicResource Loc.Find.UseRegex}"
                              AutomationProperties.AutomationId="FindRegexToggle"
                              IsChecked="{Binding UseRegex, Mode=TwoWay}"
                              Content=".*" />

                <TextBlock Grid.Column="5"
                           MinWidth="60"
                           Margin="6,0"
                           FontSize="11"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="FindCountText"
                           Text="{Binding CountDisplay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Secondary.Foreground}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCountError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Find.CountError}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="6"
                        Style="{StaticResource FindBarButtonStyle}"
                        ToolTip="{DynamicResource Loc.Find.Previous}"
                        Command="{Binding FindPreviousCommand}"
                        Content="&#x25B2;" />
                <Button Grid.Column="7"
                        Style="{StaticResource FindBarButtonStyle}"
                        ToolTip="{DynamicResource Loc.Find.Next}"
                        Command="{Binding FindNextCommand}"
                        Content="&#x25BC;" />
                <Button Grid.Column="8"
                        Style="{StaticResource FindBarButtonStyle}"
                        ToolTip="{DynamicResource Loc.Find.Close}"
                        Command="{Binding CloseCommand}"
                        Content="&#x2715;" />
            </Grid>

            <Grid Margin="26,4,0,0"
                  Visibility="{Binding IsReplaceVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ReplaceBox"
                         Grid.Column="0"
                         Width="200"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="FindReplaceBox" />
                <Button Grid.Column="1"
                        Style="{StaticResource FindBarWideButtonStyle}"
                        ToolTip="{DynamicResource Loc.Find.ReplaceOne}"
                        AutomationProperties.AutomationId="FindReplaceOneButton"
                        Command="{Binding ReplaceCurrentCommand}">
                    <TextBlock Text="{DynamicResource Loc.Find.ReplaceOne}" FontSize="11" />
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource FindBarWideButtonStyle}"
                        ToolTip="{DynamicResource Loc.Find.ReplaceAll}"
                        AutomationProperties.AutomationId="FindReplaceAllButton"
                        Command="{Binding ReplaceAllCommand}">
                    <TextBlock Text="{DynamicResource Loc.Find.ReplaceAll}" FontSize="11" />
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
