<UserControl x:Class="Mnemosyne.Views.SearchPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Mnemosyne.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="SearchMatchTemplate" DataType="{x:Type vm:SearchResultMatchViewModel}">
            <StackPanel Orientation="Horizontal" Height="20" ToolTip="{Binding Location.FullPath}"
                        AutomationProperties.Name="{Binding DisplayText}">
                <TextBlock Text="{Binding LineNumberDisplay}"
                           Width="36"
                           Margin="0,0,6,0"
                           FontSize="11"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Secondary.Foreground}" />
                <TextBlock FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.Window.Foreground}">
                    <Run Text="{Binding PrefixText, Mode=OneWay}" />
                    <Run Text="{Binding MatchText, Mode=OneWay}"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Accent}" />
                    <Run Text="{Binding SuffixText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="SearchFileTemplate"
                                  DataType="{x:Type vm:SearchResultFileViewModel}"
                                  ItemsSource="{Binding Matches}"
                                  ItemTemplate="{StaticResource SearchMatchTemplate}">
            <StackPanel Orientation="Horizontal" Height="22" ToolTip="{Binding ToolTipText}">
                <TextBlock Text="{Binding FileName}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Window.Foreground}" />
                <TextBlock Text="{Binding DirectoryDisplay}"
                           FontSize="11"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Secondary.Foreground}" />
                <TextBlock Text="{Binding CountDisplay}"
                           FontSize="11"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Secondary.Foreground}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="SearchResultItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
            <EventSetter Event="MouseDoubleClick" Handler="ResultItem_MouseDoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="RowBorder" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="16" Height="20">
                                                    <Path x:Name="Arrow"
                                                          Width="8" Height="8"
                                                          Stretch="Uniform"
                                                          Data="M1,0 L7,4 L1,8 Z"
                                                          Fill="{DynamicResource Brush.Secondary.Foreground}"
                                                          RenderTransformOrigin="0.5,0.5" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"
                                            Margin="16,0,0,0"
                                            Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush.Hover.Background}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush.Sidebar.Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Secondary.Foreground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16" />
        </Style>

        <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Secondary.Foreground}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Secondary.Foreground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Loc.SideBar.Search.Title}"
                   Style="{StaticResource SidebarTitleStyle}" />

        <StackPanel Grid.Row="1" Margin="8,0,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         FontSize="12"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="FolderSearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="Box_KeyDown" />
                <ToggleButton Grid.Column="1"
                              Style="{StaticResource FindBarToggleStyle}"
                              ToolTip="{DynamicResource Loc.Find.MatchCase}"
                              AutomationProperties.AutomationId="FolderSearchMatchCaseToggle"
                              IsChecked="{Binding MatchCase, Mode=TwoWay}"
                              Content="Aa" />
                <ToggleButton Grid.Column="2"
                              Style="{StaticResource FindBarToggleStyle}"
                              ToolTip="{DynamicResource Loc.Find.WholeWord}"
                              AutomationProperties.AutomationId="FolderSearchWholeWordToggle"
                              IsChecked="{Binding WholeWord, Mode=TwoWay}">
                    <TextBlock Text="ab"
                               FontSize="11"
                               TextDecorations="Underline" />
                </ToggleButton>
                <ToggleButton Grid.Column="3"
                              Style="{StaticResource FindBarToggleStyle}"
                              ToolTip="{DynamicResource Loc.Find.UseRegex}"
                              AutomationProperties.AutomationId="FolderSearchRegexToggle"
                              IsChecked="{Binding UseRegex, Mode=TwoWay}"
                              Content=".*" />
                <Button Grid.Column="4"
                        Style="{StaticResource FindBarButtonStyle}"
                        ToolTip="{DynamicResource Loc.Common.Cancel}"
                        AutomationProperties.AutomationId="FolderSearchCancelButton"
                        Command="{Binding CancelSearchCommand}"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}"
                        Content="&#x2715;" />
            </Grid>

            <TextBlock Text="{DynamicResource Loc.Search.Include.Label}"
                       Style="{StaticResource FieldLabelStyle}" />
            <Grid>
                <TextBox x:Name="IncludeBox"
                         FontSize="12"
                         AutomationProperties.AutomationId="FolderSearchIncludeBox"
                         Text="{Binding IncludePattern, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="Box_KeyDown" />
                <TextBlock Text="{DynamicResource Loc.Search.Include.Placeholder}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=IncludeBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock Text="{DynamicResource Loc.Search.Exclude.Label}"
                       Style="{StaticResource FieldLabelStyle}" />
            <Grid>
                <TextBox x:Name="ExcludeBox"
                         FontSize="12"
                         AutomationProperties.AutomationId="FolderSearchExcludeBox"
                         Text="{Binding ExcludePattern, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="Box_KeyDown" />
                <TextBlock Text="{DynamicResource Loc.Search.Exclude.Placeholder}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=ExcludeBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Margin="8,4,8,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Secondary.Foreground}"
                   AutomationProperties.AutomationId="FolderSearchStatus"
                   Text="{Binding StatusText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <TreeView x:Name="ResultsTree"
                      ItemsSource="{Binding ResultFiles}"
                      ItemTemplate="{StaticResource SearchFileTemplate}"
                      ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                      Background="Transparent"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      AutomationProperties.AutomationId="FolderSearchResults"
                      Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{DynamicResource Loc.Search.NoFolder}"
                       Style="{StaticResource HintTextStyle}"
                       Visibility="{Binding ShowNoFolderHint, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{DynamicResource Loc.SideBar.Search.Empty}"
                       Style="{StaticResource HintTextStyle}"
                       Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{DynamicResource Loc.Find.NoResults}"
                       Style="{StaticResource HintTextStyle}"
                       Visibility="{Binding ShowNoResultsHint, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
