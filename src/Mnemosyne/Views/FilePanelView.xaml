<UserControl x:Class="Mnemosyne.Views.FilePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Loc.SideBar.Files.Title}"
                   Style="{StaticResource SidebarTitleStyle}" />
        <TextBlock Grid.Row="1"
                   Text="{DynamicResource Loc.SideBar.Files.Empty}"
                   Foreground="{DynamicResource Brush.Secondary.Foreground}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="16" />
    </Grid>
</UserControl>
