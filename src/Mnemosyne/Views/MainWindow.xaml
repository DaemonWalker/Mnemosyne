<Window x:Class="Mnemosyne.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cmd="clr-namespace:Mnemosyne.Commands"
        xmlns:models="clr-namespace:Mnemosyne.Models"
        xmlns:views="clr-namespace:Mnemosyne.Views"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Resources/mnemosyne.ico"
        Width="1000" Height="640"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Background="{DynamicResource Brush.Window.Background}"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static cmd:AppCommands.OpenFile}" Executed="OpenFileCommand_Executed" />
        <CommandBinding Command="{x:Static cmd:AppCommands.OpenFolder}" Executed="OpenFolderCommand_Executed" />
        <CommandBinding Command="{x:Static cmd:AppCommands.Save}" Executed="SaveCommand_Executed" CanExecute="SaveLikeCommand_CanExecute" />
        <CommandBinding Command="{x:Static cmd:AppCommands.SaveAs}" Executed="SaveAsCommand_Executed" CanExecute="SaveLikeCommand_CanExecute" />
        <CommandBinding Command="{x:Static cmd:AppCommands.Find}" Executed="FindCommand_Executed" CanExecute="SaveCommand_CanExecute" />
        <CommandBinding Command="{x:Static cmd:AppCommands.Replace}" Executed="ReplaceCommand_Executed" CanExecute="SaveCommand_CanExecute" />
        <CommandBinding Command="{x:Static cmd:AppCommands.SearchInFolder}" Executed="SearchInFolderCommand_Executed" />
        <CommandBinding Command="{x:Static cmd:AppCommands.CloseTab}" Executed="CloseTabCommand_Executed" CanExecute="SaveCommand_CanExecute" />
        <CommandBinding Command="{x:Static cmd:AppCommands.SelectNextOccurrence}" Executed="SelectNextOccurrenceCommand_Executed" CanExecute="SaveCommand_CanExecute" />
        <CommandBinding Command="{x:Static cmd:AppCommands.FormatDocument}" Executed="FormatDocumentCommand_Executed" CanExecute="FormatDocumentCommand_CanExecute" />
        <CommandBinding Command="{x:Static cmd:AppCommands.OpenMarkdownPreview}" Executed="OpenMarkdownPreviewCommand_Executed" CanExecute="OpenMarkdownPreviewCommand_CanExecute" />
        <CommandBinding Command="{x:Static cmd:AppCommands.NewFile}" Executed="NewFileCommand_Executed" />
        <CommandBinding Command="{x:Static cmd:AppCommands.OpenSettings}" Executed="OpenSettingsCommand_Executed" />
        <CommandBinding Command="{x:Static cmd:AppCommands.ToggleTerminal}" Executed="ToggleTerminalCommand_Executed" />
        <CommandBinding Command="{x:Static cmd:AppCommands.NewTerminalTab}" Executed="NewTerminalTabCommand_Executed" />
    </Window.CommandBindings>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Brush.TitleBar.Background}">
            <Grid>
                <Menu HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="{DynamicResource Loc.Menu.File}">
                <MenuItem Header="{DynamicResource Loc.Menu.File.NewFile}" Command="{x:Static cmd:AppCommands.NewFile}" />
                <MenuItem Header="{DynamicResource Loc.Menu.File.Open}" Command="{x:Static cmd:AppCommands.OpenFile}" />
                <MenuItem Header="{DynamicResource Loc.Menu.File.OpenFolder}" Command="{x:Static cmd:AppCommands.OpenFolder}" />
                <MenuItem x:Name="RecentFilesMenu"
                          Header="{DynamicResource Loc.Menu.File.RecentFiles}"
                          SubmenuOpened="RecentFilesMenu_SubmenuOpened">
                    <MenuItem Header="{DynamicResource Loc.Menu.File.RecentEmpty}" IsEnabled="False" />
                </MenuItem>
                <MenuItem x:Name="RecentFoldersMenu"
                          Header="{DynamicResource Loc.Menu.File.RecentFolders}"
                          SubmenuOpened="RecentFoldersMenu_SubmenuOpened">
                    <MenuItem Header="{DynamicResource Loc.Menu.File.RecentEmpty}" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Loc.Menu.File.Save}" Command="{x:Static cmd:AppCommands.Save}" />
                <MenuItem Header="{DynamicResource Loc.Menu.File.SaveAs}" Command="{x:Static cmd:AppCommands.SaveAs}" />
                <MenuItem Header="{DynamicResource Loc.Menu.File.CloseTab}" Command="{x:Static cmd:AppCommands.CloseTab}" />
                <Separator />
                <MenuItem Header="{DynamicResource Loc.Menu.File.Settings}" Command="{x:Static cmd:AppCommands.OpenSettings}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.Edit}">
                <MenuItem Header="{DynamicResource Loc.Menu.Edit.Find}" Command="{x:Static cmd:AppCommands.Find}" />
                <MenuItem Header="{DynamicResource Loc.Menu.Edit.Replace}" Command="{x:Static cmd:AppCommands.Replace}" />
                <MenuItem Header="{DynamicResource Loc.Menu.Edit.SearchInFolder}" Command="{x:Static cmd:AppCommands.SearchInFolder}" />
                <Separator />
                <MenuItem Header="{DynamicResource Loc.Menu.Edit.SelectNextOccurrence}" Command="{x:Static cmd:AppCommands.SelectNextOccurrence}" />
                <Separator />
                <MenuItem Header="{DynamicResource Loc.Menu.Edit.FormatDocument}" Command="{x:Static cmd:AppCommands.FormatDocument}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.View}">
                <MenuItem Header="{DynamicResource Loc.Menu.View.WordWrap}"
                          IsCheckable="True"
                          IsChecked="{Binding WordWrap, Mode=TwoWay}" />
                <MenuItem Header="{DynamicResource Loc.Menu.View.ShowWhitespace}"
                          IsCheckable="True"
                          IsChecked="{Binding ShowWhitespace, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="{DynamicResource Loc.Menu.View.MarkdownPreview}"
                          Command="{x:Static cmd:AppCommands.OpenMarkdownPreview}" />
                <MenuItem Header="{DynamicResource Loc.Menu.View.Terminal}"
                          Command="{x:Static cmd:AppCommands.ToggleTerminal}"
                          InputGestureText="Ctrl+`" />
                <MenuItem Header="{DynamicResource Loc.Menu.View.NewTerminalTab}"
                          Command="{x:Static cmd:AppCommands.NewTerminalTab}"
                          InputGestureText="Ctrl+Shift+`" />
            </MenuItem>
                </Menu>

                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{DynamicResource Brush.Secondary.Foreground}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="{DynamicResource Loc.TitleBar.Minimize}"
                            AutomationProperties.Name="{DynamicResource Loc.TitleBar.Minimize}"
                            Click="MinimizeButton_Click">
                        <Path Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Data="M0,5.5 H10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="{DynamicResource Loc.TitleBar.Maximize}"
                            AutomationProperties.Name="{DynamicResource Loc.TitleBar.Maximize}"
                            Click="MaximizeButton_Click">
                        <Grid>
                            <Path x:Name="MaximizeIcon"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" />
                            <Path x:Name="RestoreIcon"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Data="M2.5,0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButtonStyle}"
                            ToolTip="{DynamicResource Loc.TitleBar.Close}"
                            AutomationProperties.Name="{DynamicResource Loc.TitleBar.Close}"
                            Click="CloseButton_Click">
                        <Path Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Data="M0.5,0.5 L9.5,9.5 M0.5,9.5 L9.5,0.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1">
        <Border DockPanel.Dock="Bottom"
                Height="24"
                Background="{DynamicResource Brush.StatusBar.Background}">
            <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasOpenDocuments, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ActiveDocument.PositionDisplay}"
                               Foreground="{DynamicResource Brush.StatusBar.Foreground}"
                               VerticalAlignment="Center"
                               Margin="8,0" />
                    <Button Style="{StaticResource StatusBarButtonStyle}"
                            Content="{Binding ActiveDocument.EncodingName}"
                            Click="EncodingButton_Click" />
                    <Button Style="{StaticResource StatusBarButtonStyle}"
                            Content="{Binding ActiveDocument.LineEndingName}"
                            Click="LineEndingButton_Click" />
                    <Button Style="{StaticResource StatusBarButtonStyle}"
                            Content="{Binding ActiveDocument.LanguageName}"
                            Click="LanguageButton_Click" />
                    <Button Style="{StaticResource StatusBarButtonStyle}"
                            Content="{Binding ActiveDocument.IndentDisplay}"
                            Click="IndentButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="{Binding LoadProgressVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding LoadProgressText}"
                               Foreground="{DynamicResource Brush.StatusBar.Foreground}"
                               VerticalAlignment="Center" />
                    <ProgressBar Width="120"
                                 Height="10"
                                 Margin="8,0,4,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding LoadProgressPercent}"
                                 VerticalAlignment="Center" />
                    <Button Style="{StaticResource StatusBarButtonStyle}"
                            Content="{DynamicResource Loc.Status.CancelLoad}"
                            Command="{Binding CancelLoadCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.ActivityBar.Background}">
                <StackPanel>
                    <ToggleButton Style="{StaticResource ActivityBarButtonStyle}"
                                  ToolTip="{DynamicResource Loc.Activity.Files.Tooltip}"
                                  IsChecked="{Binding IsFilePanelVisible, Mode=OneWay}"
                                  Command="{Binding ToggleActivityCommand}"
                                  CommandParameter="{x:Static models:ActivityPanel.Files}">
                        <Path Width="22" Height="22" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                            <Path.Data>
                                <GeometryGroup FillRule="EvenOdd">
                                    <PathGeometry Figures="M6,2 H14 L20,8 V22 H6 Z M14,2 V8 H20" />
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ActivityBarButtonStyle}"
                                  ToolTip="{DynamicResource Loc.Activity.Search.Tooltip}"
                                  IsChecked="{Binding IsSearchPanelVisible, Mode=OneWay}"
                                  Command="{Binding ToggleActivityCommand}"
                                  CommandParameter="{x:Static models:ActivityPanel.Search}">
                        <Path Width="22" Height="22" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                            <Path.Data>
                                <GeometryGroup FillRule="EvenOdd">
                                    <EllipseGeometry Center="10,10" RadiusX="7" RadiusY="7" />
                                    <EllipseGeometry Center="10,10" RadiusX="4.5" RadiusY="4.5" />
                                    <RectangleGeometry Rect="14.2,14.2,3.6,8">
                                        <RectangleGeometry.Transform>
                                            <RotateTransform Angle="45" CenterX="16" CenterY="14.2" />
                                        </RectangleGeometry.Transform>
                                    </RectangleGeometry>
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource Brush.Sidebar.Background}"
                    BorderBrush="{DynamicResource Brush.Control.Border}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <views:FilePanelView DataContext="{Binding FileTree}"
                                         Visibility="{Binding DataContext.IsFilePanelVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                    <views:SearchPanelView x:Name="SearchPanel"
                                           DataContext="{Binding SearchPanel}"
                                           Visibility="{Binding DataContext.IsSearchPanelVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisibility}}" />

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="TerminalRow" Height="0" />
                </Grid.RowDefinitions>

                <TabControl x:Name="DocumentTabs"
                            ItemsSource="{Binding Documents}"
                            SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                            AllowDrop="True"
                            PreviewMouseDown="DocumentTabs_PreviewMouseDown"
                            PreviewMouseLeftButtonDown="DocumentTabs_PreviewMouseLeftButtonDown"
                            MouseMove="DocumentTabs_MouseMove"
                            DragOver="DocumentTabs_DragOver"
                            Drop="DocumentTabs_Drop"
                            Visibility="{Binding HasOpenDocuments, Converter={StaticResource BoolToVisibility}}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25CF;"
                                           FontSize="9"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Window.Foreground}"
                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding DisplayTitle}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource TabCloseButtonStyle}"
                                        Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate />
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- 搜索/替换条：WPF/WinForms 空域限制下 WPF 浮层无法覆盖 WindowsFormsHost（Scintilla），
                     故占编辑器区顶部一整行（右对齐），收起时高度为 0 -->
                <Grid Grid.Row="1">
                    <views:FindBarView x:Name="FindBar"
                                       DataContext="{Binding FindBar}"
                                       HorizontalAlignment="Right"
                                       Margin="0,4,8,4"
                                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- ScintillaHost（WindowsFormsHost）从可视树移除会销毁原生句柄并丢失文档内容，
                     因此所有实例常驻此 Grid，仅切换 Visibility，不经 TabControl ContentPresenter 换页 -->
                <Grid x:Name="EditorHostGrid"
                      Grid.Row="2"
                      Background="{DynamicResource Brush.Window.Background}" />

                <TextBlock Grid.Row="2"
                           Text="{DynamicResource Loc.Editor.Empty}"
                           Foreground="{DynamicResource Brush.Secondary.Foreground}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />

                <!-- 终端面板：纯 WPF 自绘无空域问题，与 FindBar 一样独占编辑区一行（不跨侧边栏），
                     面板懒加载——首次展开才创建视图与会话，不收起进冷启动路径。
                     行高与 DataContext 由 code-behind 命令式设置：绑定在 DataBind 优先级执行，
                     可能晚于 Render 阶段的尺寸/渲染事件，导致会话不启动、下拉框丢选中（竞态） -->
                <GridSplitter Grid.Row="3"
                              Height="3"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              DragCompleted="TerminalSplitter_DragCompleted"
                              Visibility="{Binding IsTerminalVisible, Converter={StaticResource BoolToVisibility}}" />
                <views:TerminalPanelView x:Name="TerminalPanel"
                                         Grid.Row="4"
                                         Visibility="{Binding IsTerminalVisible, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
        </DockPanel>
    </Grid>
</Window>
