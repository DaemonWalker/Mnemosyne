<Window x:Class="Mnemosyne.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.App.Title}"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}">
    <!-- Step 1 临时演示控件：验证主题/语言切换与设置落盘，Step 2 替换为正式布局 -->
    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource Loc.Demo.Welcome}"
                   FontSize="22"
                   Foreground="{DynamicResource Brush.Window.Foreground}"
                   Margin="0,0,0,20" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Loc.Demo.Theme}"
                       Foreground="{DynamicResource Brush.Window.Foreground}"
                       VerticalAlignment="Center" Width="90" />
            <ComboBox x:Name="ThemeComboBox" Width="180" SelectionChanged="ThemeComboBox_SelectionChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Loc.Demo.Language}"
                       Foreground="{DynamicResource Brush.Window.Foreground}"
                       VerticalAlignment="Center" Width="90" />
            <ComboBox x:Name="LanguageComboBox" Width="180" SelectionChanged="LanguageComboBox_SelectionChanged" />
        </StackPanel>
        <TextBlock Text="{DynamicResource Loc.Demo.PendingPaths}"
                   Foreground="{DynamicResource Brush.Secondary.Foreground}"
                   Margin="0,20,0,4" />
        <TextBlock x:Name="PendingPathsText"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Secondary.Foreground}" />
    </StackPanel>
</Window>
