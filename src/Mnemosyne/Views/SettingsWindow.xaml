<Window x:Class="Mnemosyne.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:abs="clr-namespace:Mnemosyne.Plugin.Abstractions;assembly=Mnemosyne.Plugin.Abstractions"
        Title="{DynamicResource Loc.Settings.Title}"
        Icon="pack://application:,,,/Resources/mnemosyne.ico"
        Width="480"
        SizeToContent="Height"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Window.Foreground}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SettingsLabelStyle">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Window.Foreground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 按设置项类型显示对应控件（默认 Collapsed，匹配 Type 时 Visible） -->
        <Style TargetType="CheckBox" x:Key="PluginBoolEditorStyle">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static abs:PluginSettingType.Bool}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" x:Key="PluginTextEditorStyle">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static abs:PluginSettingType.String}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static abs:PluginSettingType.Int}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static abs:PluginSettingType.Path}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" x:Key="PluginEnumEditorStyle">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static abs:PluginSettingType.Enum}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
        <StackPanel Margin="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SettingsLabelStyle}" Text="{DynamicResource Loc.Settings.Font}" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                          ItemsSource="{Binding FontFamilies}"
                          SelectedValuePath="FamilyName"
                          SelectedValue="{Binding SelectedFontFamily, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonospace}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Style="{StaticResource SettingsLabelStyle}" Text="{DynamicResource Loc.Settings.FontSize}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                         Width="80" HorizontalAlignment="Left"
                         Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Style="{StaticResource SettingsLabelStyle}" Text="{DynamicResource Loc.Settings.UiFont}" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4"
                          ItemsSource="{Binding UiFontFamilies}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="FamilyName"
                          SelectedValue="{Binding SelectedUiFontFamily, Mode=TwoWay}" />

                <TextBlock Grid.Row="3" Style="{StaticResource SettingsLabelStyle}" Text="{DynamicResource Loc.Settings.UiFontSize}" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4"
                         Width="80" HorizontalAlignment="Left"
                         Text="{Binding UiFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="4" Style="{StaticResource SettingsLabelStyle}" Text="{DynamicResource Loc.Settings.Theme}" />
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4"
                          ItemsSource="{Binding Themes}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedTheme, Mode=TwoWay}" />

                <TextBlock Grid.Row="5" Style="{StaticResource SettingsLabelStyle}" Text="{DynamicResource Loc.Settings.Language}" />
                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4"
                          ItemsSource="{Binding Languages}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />

                <TextBlock Grid.Row="6" Style="{StaticResource SettingsLabelStyle}" Text="{DynamicResource Loc.Settings.Indent}" />
                <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,4"
                          ItemsSource="{Binding IndentModes}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="UseTabs"
                          SelectedValue="{Binding IndentUseTabs, Mode=TwoWay}" />

                <TextBlock Grid.Row="7" Style="{StaticResource SettingsLabelStyle}" Text="{DynamicResource Loc.Settings.IndentWidth}" />
                <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,4"
                          Width="80" HorizontalAlignment="Left"
                          ItemsSource="{Binding IndentWidths}"
                          SelectedItem="{Binding IndentWidth, Mode=TwoWay}" />

                <TextBlock Grid.Row="8" Style="{StaticResource SettingsLabelStyle}" Text="{DynamicResource Loc.Settings.LargeFileThreshold}" />
                <TextBox Grid.Row="8" Grid.Column="1" Margin="0,4"
                         Width="80" HorizontalAlignment="Left"
                         Text="{Binding LargeFileThresholdMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Grid.Row="9" Grid.Column="1" Margin="0,6"
                          Content="{DynamicResource Loc.Settings.WordWrap}"
                          IsChecked="{Binding WordWrap, Mode=TwoWay}" />

                <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,2"
                          Content="{DynamicResource Loc.Settings.ShowWhitespace}"
                          IsChecked="{Binding ShowWhitespace, Mode=TwoWay}" />

                <CheckBox Grid.Row="11" Grid.Column="1" Margin="0,2"
                          Content="{DynamicResource Loc.Settings.HideDotFiles}"
                          IsChecked="{Binding HideDotFiles, Mode=TwoWay}" />

                <CheckBox Grid.Row="12" Grid.Column="1" Margin="0,2,0,6"
                          Content="{DynamicResource Loc.Settings.HideHiddenFiles}"
                          IsChecked="{Binding HideHiddenFiles, Mode=TwoWay}" />

                <CheckBox Grid.Row="13" Grid.Column="1" Margin="0,2"
                          IsChecked="{Binding AllowMultipleInstances, Mode=TwoWay}">
                    <TextBlock Text="{DynamicResource Loc.Settings.AllowMultipleInstances}" TextWrapping="Wrap" />
                </CheckBox>

                <CheckBox Grid.Row="14" Grid.Column="1" Margin="0,2"
                          IsChecked="{Binding ShellFileContextMenu, Mode=TwoWay}">
                    <TextBlock Text="{DynamicResource Loc.Settings.ShellFileContextMenu}" TextWrapping="Wrap" />
                </CheckBox>

                <CheckBox Grid.Row="15" Grid.Column="1" Margin="0,2,0,6"
                          IsChecked="{Binding ShellFolderContextMenu, Mode=TwoWay}">
                    <TextBlock Text="{DynamicResource Loc.Settings.ShellFolderContextMenu}" TextWrapping="Wrap" />
                </CheckBox>

                <TextBlock Grid.Row="16" Style="{StaticResource SettingsLabelStyle}" Text="{DynamicResource Loc.Settings.TerminalShell}" />
                <ComboBox Grid.Row="16" Grid.Column="1" Margin="0,4"
                          Width="140" HorizontalAlignment="Left"
                          ItemsSource="{Binding TerminalShells}"
                          SelectedItem="{Binding SelectedTerminalShell, Mode=TwoWay}" />
            </Grid>

            <!-- 插件设置分区：按各插件声明的 schema 动态渲染；无插件设置项时整体隐藏 -->
            <StackPanel Visibility="{Binding HasPluginSettings, Converter={StaticResource BoolToVisibility}}">
                <Separator Margin="0,12,0,4" />
                <TextBlock Text="{DynamicResource Loc.Settings.Plugins}" FontWeight="Bold" Margin="0,4" />
                <ItemsControl ItemsSource="{Binding PluginGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="0,2" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Foreground="{DynamicResource Brush.Window.Foreground}" Opacity="0.65" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SettingsLabelStyle}"
                                                           Text="{Binding DisplayName}"
                                                           ToolTip="{Binding Description}" />
                                                <CheckBox Grid.Column="1" Margin="0,2"
                                                          Style="{StaticResource PluginBoolEditorStyle}"
                                                          IsChecked="{Binding BoolValue, Mode=TwoWay}" />
                                                <TextBox Grid.Column="1" Margin="0,2"
                                                         Style="{StaticResource PluginTextEditorStyle}"
                                                         Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ComboBox Grid.Column="1" Margin="0,2"
                                                          Style="{StaticResource PluginEnumEditorStyle}"
                                                          ItemsSource="{Binding EnumValues}"
                                                          SelectedItem="{Binding SelectedEnumValue, Mode=TwoWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button MinWidth="80" Margin="0,0,8,0" IsDefault="True"
                        Content="{DynamicResource Loc.Settings.Save}"
                        Command="{Binding SaveCommand}" />
                <Button MinWidth="80" IsCancel="True"
                        Content="{DynamicResource Loc.Common.Cancel}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
