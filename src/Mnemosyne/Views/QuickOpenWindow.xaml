<Window x:Class="Mnemosyne.Views.QuickOpenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.QuickOpen.Title}"
        Icon="pack://application:,,,/Resources/mnemosyne.ico"
        Width="560" Height="420"
        MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Loc.QuickOpen.Filter}"
                   Foreground="{DynamicResource Brush.Secondary.Foreground}"
                   FontSize="11"
                   Margin="0,0,0,4" />
        <TextBox x:Name="FilterBox"
                 Grid.Row="1"
                 TextChanged="FilterBox_TextChanged" />
        <ListBox x:Name="FileList"
                 Grid.Row="2"
                 Margin="0,8"
                 MouseDoubleClick="FileList_MouseDoubleClick"
                 KeyDown="FileList_KeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding FileName}" Padding="2,0" />
                        <TextBlock Text="{Binding DisplayPath}"
                                   Foreground="{DynamicResource Brush.Secondary.Foreground}"
                                   FontSize="11"
                                   Padding="2,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{DynamicResource Loc.Common.Ok}"
                    MinWidth="80"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="{DynamicResource Loc.Common.Cancel}"
                    MinWidth="80"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
