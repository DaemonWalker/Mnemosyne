<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mnemosyne.Formatters.Json</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件不随主程序引用，构建后由下方 Target 拷贝到主程序输出 plugins/ 目录 -->
    <ProjectReference Include="..\..\src\Mnemosyne.Plugin.Abstractions\Mnemosyne.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- netstandard2.0 无内置 System.Text.Json；编译用 8.0.x，运行时由主程序（net10）自带的更高版本承载 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <Target Name="CopyPluginToAppOutput" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\src\Mnemosyne\bin\$(Configuration)\net10.0-windows\plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>
